# YBF × Edison — Environment Variables (örnek)
#
# Bu dosyayı `.env` olarak kopyala VE düzenle:
#   cp .env.example .env
#
# YA DA env var'ları direkt shell'de set et:
#   export EDISON_API_KEY=$(security find-generic-password -s futurehouse-api-key -w)
#
# YA DA hiçbir şey set etme — test_single.py keychain'den otomatik çeker
# (futurehouse-api-key service'inden).

EDISON_API_KEY=your_edison_api_key_here

# Opsiyonel — sadece API timeout uzatmak isterseniz
# EDISON_TIMEOUT_SECONDS=900
